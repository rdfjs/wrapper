            "AsyncDatasetCore": "https://github.com/jeswr/async-dataset/blob/feat/async-dataset/src/AsyncDatasetCore.ts",
            "DatasetCoreSource": "https://github.com/jeswr/async-dataset/blob/feat/async-dataset/src/AsyncDatasetCore.ts"
        },
