    "rdfjs",
    "mapping",
    "wrapper"
  ],
  "contributors": [
    "Matthieu Bosquet (https://github.com/matthieubosquet)",
    "Samu Lang (https://github.com/langsamu)"
  ],
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@rdfjs/types": "^2",
    "@types/node": "^25",
    "typescript": "^6",
    "@types/n3": "^1",
    "n3": "^2",
    "typedoc": "^0.28.18",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "rimraf": "^6.0.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
