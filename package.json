{
  "name": "@rdfjs/wrapper",
  "version": "0.34.0",
  "description": "RDF/JS object mapping library",
  "main": "dist/mod.js",
  "type": "module",
  "types": "./dist/mod.d.ts",
  "exports": {
    ".": "./dist/mod.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rdfjs/wrapper.git"
  },
  "scripts": {
    "start": "npm test",
    "build:test": "rimraf dist test/dist && tsc && tsc -p test",
    "test": "npm run build:test && node --experimental-test-coverage --test \"**/*.test.js\""
  },
  "keywords": [
    "rdf",
